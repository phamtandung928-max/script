-- FIX LAG
-- Disable supported visual effects, remove shadows,
-- and make world BaseParts gray and translucent.
-- Turning Fix Lag off restores saved local properties.
addSection("PERFORMANCE")

local fixEnabled = false
local savedEffects = {}
local savedWorldParts = {}
local savedShadows = nil
local descendantConnection = nil
local lightingEffectConnection = nil

local function isVisualEffect(obj)
    return obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles")
        or obj:IsA("PostEffect")
end

local function disableEffect(obj)
    if not fixEnabled or not isVisualEffect(obj) then
        return
    end

    if savedEffects[obj] == nil then
        local ok, enabled = pcall(function()
            return obj.Enabled
        end)

        if ok then
            savedEffects[obj] = enabled
        end
    end

    pcall(function()
        obj.Enabled = false
    end)
end

local function grayTransparentPart(obj)
    if not fixEnabled or not obj:IsA("BasePart") then
        return
    end

    if savedWorldParts[obj] == nil then
        savedWorldParts[obj] = {
            Color = obj.Color,
            Transparency = obj.Transparency,
        }
    end

    pcall(function()
        obj.Color = Color3.fromRGB(125, 125, 125)
        obj.Transparency = math.max(obj.Transparency, 0.35)
    end)
end

local function processWorldObject(obj)
    disableEffect(obj)
    grayTransparentPart(obj)
end

local function setFixLag(on)
    if on == fixEnabled then return end

    fixEnabled = on

    if on then
        savedShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false

        for _, obj in ipairs(workspace:GetDescendants()) do
            processWorldObject(obj)
        end

        for _, obj in ipairs(Lighting:GetDescendants()) do
            disableEffect(obj)
        end

        descendantConnection = workspace.DescendantAdded:Connect(function(obj)
            task.defer(processWorldObject, obj)
        end)

        lightingEffectConnection = Lighting.DescendantAdded:Connect(function(obj)
            task.defer(disableEffect, obj)
        end)
    else
        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end

        if lightingEffectConnection then
            lightingEffectConnection:Disconnect()
            lightingEffectConnection = nil
        end

        for obj, wasEnabled in pairs(savedEffects) do
            if obj and obj.Parent then
                pcall(function()
                    obj.Enabled = wasEnabled
                end)
            end
        end

        table.clear(savedEffects)

        for obj, original in pairs(savedWorldParts) do
            if obj and obj.Parent then
                pcall(function()
                    obj.Color = original.Color
                    obj.Transparency = original.Transparency
                end)
            end
        end

        table.clear(savedWorldParts)

        if savedShadows ~= nil then
            Lighting.GlobalShadows = savedShadows
            savedShadows = nil
        end
    end
end

