-- SLIDER
local function addSlider(text, minValue, maxValue, initial, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 55)
    row.BackgroundColor3 = C.panel
    row.BorderSizePixel = 0
    row.Parent = content
    corner(row, 8)

    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(10, 3)
    label.Size = UDim2.new(1, -20, 0, 19)
    label.BackgroundTransparency = 1
    label.TextColor3 = C.text
    label.TextSize = 11
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local track = Instance.new("TextButton")
    track.Name = "SliderTrack"
    track.Position = UDim2.new(0, 10, 0, 34)
    track.Size = UDim2.new(1, -20, 0, 7)
    track.BackgroundColor3 = C.off
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row
    corner(track, 4)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C.purple
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 4)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(13, 13)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = track
    corner(knob, 8)

    local value = initial

    local function setValue(v)
        value = math.clamp(
            math.floor(v + 0.5),
            minValue,
            maxValue
        )

        local p = (value - minValue) / (maxValue - minValue)

        label.Text = text .. ": " .. tostring(value)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)

        callback(value)
    end

    local function setFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local p = math.clamp(
            (x - track.AbsolutePosition.X) / width,
            0,
            1
        )

        setValue(minValue + p * (maxValue - minValue))
    end

    local sliding = false

    connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputChanged, function(input)
        if sliding and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    setValue(initial)

    return setValue
end

-- DRAG MENU AND FLOATING PANELS
local function makeDraggable(handle, target, tapCallback)
    handle.Active = true

    local dragging = false
    local moved = false
    local activeInputType = nil
    local activeTouch = nil
    local startInputPosition = nil
    local startObjectPosition = nil

    local function moveTo(position)
        if not dragging then return end

        local delta = position - startInputPosition

        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            moved = true
        end

        target.Position = UDim2.new(
            startObjectPosition.X.Scale,
            startObjectPosition.X.Offset + delta.X,
            startObjectPosition.Y.Scale,
            startObjectPosition.Y.Offset + delta.Y
        )
    end

    connect(handle.InputBegan, function(input)
        local kind = input.UserInputType

        if kind ~= Enum.UserInputType.Touch
        and kind ~= Enum.UserInputType.MouseButton1 then
            return
        end

        dragging = true
        moved = false
        activeInputType = kind
        activeTouch = kind == Enum.UserInputType.Touch and input or nil
        startInputPosition = input.Position
        startObjectPosition = target.Position
    end)

    connect(UIS.InputChanged, function(input)
        if not dragging then return end

        if activeInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseMovement then
            moveTo(input.Position)
        end
    end)

    connect(UIS.TouchMoved, function(input)
        if dragging
        and activeInputType == Enum.UserInputType.Touch
        and activeTouch == input then
            moveTo(input.Position)
        end
    end)

    connect(UIS.InputEnded, function(input)
        local mouseEnd =
            activeInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1

        local touchEnd =
            activeInputType == Enum.UserInputType.Touch
            and input == activeTouch

        if dragging and (mouseEnd or touchEnd) then
            dragging = false
            activeInputType = nil
            activeTouch = nil

            if not moved and tapCallback then
                tapCallback()
            end
        end
    end)
end

